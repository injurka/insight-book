{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build:tauri": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "tauri:build": {
      "dependsOn": ["@injurkx/insight-book-client#build:tauri"],
      "outputs": ["src-tauri/target/**", "src-tauri/gen/**"]
    },
    "tauri:dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "lint:fix": {
      "cache": false
    },
    "typecheck": {}
  }
}
