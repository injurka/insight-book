{
  "name": "@injurka/insight-book-zh-dict-parser",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "--------------------------------<      DEV       >--------------------------------": "",
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "--------------------------------<      BUILD     >--------------------------------": "",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --no-minify",
    "--------------------------------<   TAURI   >---------------------------------": "",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "epub2": "^3.0.2",
    "node-html-parser": "^9.0.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.2.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.2",
    "bun": "^1.3.14",
    "bun-types": "^1.3.14",
    "eslint": "^10.8.0",
    "eslint-plugin-format": "2.0.1",
    "typescript": "6.0.3"
  }
}
