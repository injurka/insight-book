+// Keep declarations before their consumers, even across category boundaries.
+function sortByDependencies(statements, sourceCode) {
+  const byNode = new Map(statements.map(statement => [statement.node, statement]));
+  const dependencies = new Map(statements.map(statement => [statement, new Set()]));
+  const topLevelStatement = node => {
+    while (node && !byNode.has(node)) node = node.parent;
+    return byNode.get(node);
+  };
+  for (const scope of sourceCode.scopeManager.scopes) {
+    for (const variable of scope.variables) {
+      for (const definition of variable.defs) {
+        const declaration = topLevelStatement(definition.node);
+        if (!declaration || declaration.node.type === "FunctionDeclaration") continue;
+        for (const reference of variable.references) {
+          const consumer = topLevelStatement(reference.identifier);
+          if (consumer && consumer !== declaration && consumer.node.type !== "FunctionDeclaration") {
+            dependencies.get(consumer).add(declaration);
+          }
+        }
+      }
+    }
+  }
+  const pending = [...statements].sort((a, b) => a.order - b.order);
+  const sorted = [];
+  const emitted = new Set();
+  while (pending.length) {
+    const index = pending.findIndex(statement => [...dependencies.get(statement)].every(dependency => emitted.has(dependency)));
+    // Cyclic declarations cannot be safely reordered.
+    if (index === -1) return statements;
+    const [statement] = pending.splice(index, 1);
+    sorted.push(statement);
+    emitted.add(statement);
+  }
+  return sorted;
 }

