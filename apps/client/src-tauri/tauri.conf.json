{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "insight-book",
  "version": "0.1.0",
  "identifier": "ru.insightbook.insightbook",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "@injurkx/insight-book",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "insightbook"
        ]
      },
      "mobile": [
        {
          "host": "insight-api.trip-scheduler.ru",
          "pathPrefix": [
            "/api/auth/yandex/callback"
          ]
        },
        {
          "schemes": ["insightbook"],
          "host": "auth"
        }
      ]
    }
  }
}
