{
  "name": "@injurkx/insight-book-client",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "InsightBook Client Application",
  "author": {
    "name": "Ivan Kornilov",
    "email": "injurka@gmail.com"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "--------------------------------<      DEV       >--------------------------------": "",
    "dev": "vite --config build/vite.config.web.ts",
    "--------------------------------<      BUILD     >--------------------------------": "",
    "build": "vite build --config build/vite.config.web.ts && bun run build/inject-font-preloads.ts",
    "build:tauri": "vite build --config build/vite.config.tauri.ts",
    "deploy": "bun run build/deploy.ts",
    "check:cdn": "bun run build/check-cdn.ts",
    "preview": "vite preview --config build/vite.config.web.ts",
    "--------------------------------<      STORY     >--------------------------------": "",
    "story:dev": "STORYBOOK_ENV=1 storybook dev -p 6006",
    "story:build": "STORYBOOK_ENV=1 storybook build",
    "--------------------------------< LINT & FORMAT >---------------------------------": "",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:story": "vitest run --project storybook",
    "test:all": "vitest run",
    "typecheck": "vue-tsc -p tsconfig.app.json --noEmit",
    "--------------------------------<     UTILS     >---------------------------------": "",
    "generate-pwa-assets": "pwa-assets-generator",
    "icons:bundle": "bun run build/bundle-icons.ts"
  },
  "dependencies": {
    "@floating-ui/vue": "^2.0.1",
    "@iconify-icons/mdi": "^1.2.48",
