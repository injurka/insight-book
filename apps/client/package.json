{
  "name": "@injurkx/insight-book-client",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "InsightBook Client Application",
  "author": {
    "name": "Ivan Kornilov",
    "email": "injurka@gmail.com"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "--------------------------------<      DEV       >--------------------------------": "",
    "dev": "vite --config build/vite.config.web.ts",
    "--------------------------------<      BUILD     >--------------------------------": "",
    "build": "vite build --config build/vite.config.web.ts",
    "preview": "vite preview --config build/vite.config.web.ts",
    "--------------------------------<   TAURI   >---------------------------------": "",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:linux:x64": "tauri build --target x86_64-unknown-linux-gnu",
    "tauri:build:win:x64": "tauri build --target x86_64-pc-windows-msvc",
    "tauri:android:init": "tauri android init",
    "tauri:android:build": "tauri android build --apk",
    "--------------------------------< LINT & FORMAT >---------------------------------": "",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "vue-tsc --noEmit",
    "--------------------------------<     UTILS     >---------------------------------": "",
    "generate-pwa-assets": "pwa-assets-generator",
    "icons:bundle": "bun run build/bundle-icons.ts"
  },
  "dependencies": {
    "@aejkatappaja/phantom-ui": "^1.0.0",
    "@floating-ui/vue": "^1.1.11",
    "@iconify-icons/mdi": "^1.2.48",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@vueuse/core": "^14.3.0",
    "@vueuse/head": "^2.0.0",
    "dompurify": "^3.1.5",
    "hanzi-writer": "^3.7.3",
    "localforage": "^1.10.0",
    "pinia": "3.0.4",
    "tauri": "^0.15.0",
    "uuid": "^14.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vue": "^3.5.34",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@antfu/eslint-config": "8.2.0",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify/utils": "^3.1.2",
    "@iconify/vue": "^5.0.1",
    "@konghayao/cn-font-split": "^4.15.0",
    "@tauri-apps/cli": "^2.11.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^25.6.0",
    "@types/workbox-sw": "^4.3.7",
    "@vite-pwa/assets-generator": "1.0.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "eslint": "^9.29.0",
    "eslint-plugin-format": "2.0.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass": "1.99.0",
    "typescript": "6.0.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^8.0.10",
    "vite-plugin-compression2": "^2.5.3",
    "vitest": "^4.1.5",
    "vue-tsc": "^3.2.8",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
