{
  "name": "@injurka/insight-book-native",
  "type": "module",
  "version": "3.23.1",
  "private": true,
  "description": "InsightBook Native Shell (Tauri)",
  "author": {
    "name": "Ivan Kornilov",
    "email": "injurka@gmail.com"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:linux:x64": "tauri build --target x86_64-unknown-linux-gnu",
    "tauri:build:win:x64": "tauri build --target x86_64-pc-windows-msvc",
    "tauri:android:init": "tauri android init && bash src-tauri/setup-android.sh",
    "tauri:android:build": "bash src-tauri/setup-android.sh && tauri android build --apk"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4"
  }
}
