{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "insight-book",
  "version": "3.23.1",
  "identifier": "ru.insightbook.insightbook",
  "build": {
    "frontendDist": "../../client/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run --cwd ../.. dev:client",
    "beforeBuildCommand": "bun run --cwd ../.. build:client:tauri"
  },
  "app": {
    "windows": [
      {
        "title": "@injurkx/insight-book",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": {
        "default-src": ["'self'", "customprotocol:", "asset:"],
        "connect-src": ["'self'", "ipc:", "http://ipc.localhost", "https:"],
        "font-src": ["'self'", "data:", "https:"],
        "img-src": ["'self'", "asset:", "data:", "blob:", "https:"],
        "media-src": ["'self'", "asset:", "blob:", "https:"],
        "object-src": ["'none'"],
        "script-src": ["'self'", "https:"],
        "style-src": ["'self'", "'unsafe-inline'", "https:"],
        "worker-src": ["'self'", "blob:"]
      },
      "devCsp": null,
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "insightbook"
        ]
      },
      "mobile": [
        {
          "host": "insight-book.ru",
          "pathPrefix": [
            "/api/auth/yandex/callback"
          ]
        },
        {
          "schemes": [
            "insightbook"
          ],
          "host": "auth"
        }
      ]
    }
  }
}
