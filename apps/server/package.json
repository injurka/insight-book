{
  "name": "@injurka/insight-book-server",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "--------------------------------<      DEV       >--------------------------------": "",
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "users": "bun src/cli.ts",
    "--------------------------------<   DATABASE    >---------------------------------": "",
    "db:migrate": "bunx drizzle-kit migrate",
    "db:generate": "bunx drizzle-kit generate",
    "db:studio": "bunx drizzle-kit studio",
    "db:reset": "bunx drizzle-kit drop",
    "--------------------------------< BACKUP & DUMP >---------------------------------": "",
    "dump:create": "bun src/scripts/create-dump.ts",
    "dump:seed": "bun src/scripts/seed-from-dump.ts",
    "deck:generate": "bun src/scripts/deck/generate.ts",
    "deck:seed": "bun src/scripts/deck/seed-catalog.ts",
    "deck:inject": "bun src/scripts/deck/inject-cache.ts",
    "--------------------------------< LINT & FORMAT >---------------------------------": "",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.57",
    "@aws-sdk/client-s3": "^3.1125.0",
    "@clack/prompts": "^1.7.0",
    "@elysia/server-timing": "^1.4.1",
    "@elysiajs/opentelemetry": "^1.4.11",
    "@injurka/insight-book-language-utils": "workspace:*",
    "@kubiks/otel-drizzle": "^2.1.0",
    "@libsql/client": "^0.18.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "adm-zip": "^0.6.0",
    "ai": "^7.0.91",
    "az": "^0.2.3",
    "cheerio": "^1.2.0",
    "compromise": "^14.16.0",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.30",
    "epub2": "^3.0.2",
    "jsonwebtoken": "^9.0.3",
    "kuromoji": "^0.1.2",
    "node-html-parser": "^9.0.3",
    "nodejieba": "^3.5.8",
    "pino": "^10.3.1",
    "pino-opentelemetry-transport": "^4.0.2",
    "pinyin-pro": "^3.29.3",
    "sharp": "^0.35.4",
    "ts-fsrs": "^5.4.2",
    "web-push": "^3.6.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.5.1",
    "@types/adm-zip": "^0.5.8",
    "@types/bun": "^1.4.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^26.4.1",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.1",
    "eslint-plugin-format": "2.0.1",
    "pino-pretty": "^13.1.3",
    "typescript": "7.0.2"
  }
}
