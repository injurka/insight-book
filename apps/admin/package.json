{
  "name": "@injurka/insight-book-admin",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "InsightBook Admin Panel",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "--------------------------------<      DEV       >--------------------------------": "",
    "dev": "vite --config build/vite.config.web.ts",
    "--------------------------------<      BUILD     >--------------------------------": "",
    "build": "vite build --config build/vite.config.web.ts",
    "preview": "vite preview --config build/vite.config.web.ts",
    "--------------------------------< LINT & FORMAT >---------------------------------": "",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "vue-tsc -p tsconfig.app.json --noEmit",
    "--------------------------------<     UTILS     >---------------------------------": "",
    "icons:bundle": "bun run build/bundle-icons.ts"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.1",
    "@mdi/font": "^7.4.47",
    "ofetch": "^1.5.1",
    "pinia": "4.0.3",
    "sass": "1.103.1",
    "vue": "3.5.42",
    "vue-router": "^5.3.1",
    "vuetify": "^4.2.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.5.1",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify/utils": "^3.1.4",
    "@types/bun": "^1.4.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.9.1",
    "eslint-plugin-format": "2.0.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "7.0.2",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.2.2",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  }
