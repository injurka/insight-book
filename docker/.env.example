# ==============================================================================
# Переменные окружения для локального запуска Insight Book через Docker.
# Скопируйте этот файл в .env и заполните необходимые значения.
# ==============================================================================

# --- Настройки Авторизации ---
# 'single' - вход без пароля (для локального использования одним человеком)
# 'multi' - многопользовательский режим с окном входа
AUTH_MODE=single

# Секрет для генерации JWT токенов (ОБЯЗАТЕЛЬНО измените на случайную строку для продакшена!)
JWT_SECRET=super-secret-key

# Учетные данные первого администратора (создается автоматически при первом запуске)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# --- Настройки Больших Языковых Моделей (LLM) для анализа текста ---

# ОБЯЗАТЕЛЬНО: Ваш API ключ для доступа к LLM (OpenAI, Gemini, Anthropic и т.д.).
# Без этого ключа функции анализа текста и перевода работать не будут.
LLM_API_KEY=

# URL эндпоинта, совместимого с OpenAI API.
# По умолчанию используется прокси, который может работать с разными моделями.
LLM_API_URL=https://api.aihubmix.com/v1

# Основная модель для анализа текста. Выбирайте быструю и недорогую модель.
# Например: 'gemini-3.1-flash-lite', 'gpt-4o-mini'
LLM_MODEL=gemini-3.1-flash-lite

# Запасная модель на случай, если основная не справится или вернет ошибку.
# Рекомендуется использовать более мощную модель.
# Например: 'gpt-4o'
LLM_FALLBACK_MODEL=gpt-4o-mini


# --- Настройки Синтеза Речи (Text-to-Speech) ---

# API ключ для TTS.
# Если оставить пустым, будет использоваться значение из LLM_API_KEY.
# Заполните, если у вас отдельный ключ для TTS.
TTS_API_KEY=

# Модель для синтеза речи.
# Например: 'gpt-4o-mini-tts'
TTS_MODEL=gpt-4o-mini-tts


# ------------------------------------------------------------------------------
# СИСТЕМНЫЕ ПЕРЕМЕННЫЕ (Обычно не требуют изменений для Docker-запуска)
#
# Эти переменные уже сконфигурированы в файле docker-compose.local.yml
# и определяют пути ВНУТРИ контейнеров.
# ------------------------------------------------------------------------------
# PORT=4445
# DB_PATH=/db/insight-book.sqlite
# UPLOADS_PATH=/uploads

# --- Настройки клиента ---

# Базовый URL API для клиента. Применяется при запуске контейнера (без пересборки).
# Если не задан, клиент использует продакшен-URL по умолчанию.
VITE_API_URL=https://api.insight-book.ru

UMAMI_DB_PASSWORD=придумайте_сложный_пароль_для_бд
UMAMI_APP_SECRET=придумайте_длинную_случайную_строку_для_шифрования_сессий
