FROM oven/bun:1.3.14-slim

WORKDIR /app

COPY package.json bun.lock* ./
COPY apps/server/package.json ./apps/server/

RUN bun install --ignore-scripts

# bun nests workspace deps under apps/server/node_modules in this partial layout.
# nodejieba's own install/build scripts use npx (npm is absent in bun images), so
# fetch its official prebuilt N-API binary (node ABI v137 = what bun 1.3.14 reports)
# with node-pre-gyp, run under bun explicitly.
RUN cd apps/server/node_modules/nodejieba && bunx --bun @mapbox/node-pre-gyp install

COPY . .

WORKDIR /app/apps/server

ENV PORT=4445
ENV NODE_ENV=production

EXPOSE 4445

CMD ["bun", "run", "start"]
