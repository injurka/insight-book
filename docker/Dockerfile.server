FROM oven/bun:1.3.14-slim

WORKDIR /app

COPY package.json bun.lock* ./
COPY apps/server/package.json ./apps/server/

RUN bun install --ignore-scripts

# nodejieba: bun nests workspace deps under apps/server/node_modules in this partial
# layout, and nodejieba's own scripts need npx (absent in bun images). The build
# environment can't reliably reach github.com release assets, so the official
# prebuilt N-API binary (node ABI v137 = what bun 1.3.14 reports) is vendored
# in docker/nodejieba/ (linux-x64-glibc; re-vendor for other arch/bun ABI).
COPY docker/nodejieba/nodejieba-v3.5.8-node-v137-linux-x64-glibc.tar.gz /tmp/nodejieba.tgz
RUN cd apps/server/node_modules/nodejieba && \
    echo "22d424a2f5664dd611da643dca7f7c48fa1262247c9497952667155e2c97eeb2  /tmp/nodejieba.tgz" | sha256sum -c - && \
    mkdir -p build/Release && \
    tar -xzf /tmp/nodejieba.tgz --strip-components=1 -C build/Release && \
    rm /tmp/nodejieba.tgz

COPY . .

WORKDIR /app/apps/server

ENV PORT=4445
ENV NODE_ENV=production

EXPOSE 4445

CMD ["bun", "run", "start"]
