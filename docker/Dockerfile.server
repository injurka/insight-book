FROM oven/bun:1.2-slim

# Устанавливаем инструменты для компиляции C++ модулей
RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Копируем только файлы зависимостей
COPY package.json bun.lock ./

# Устанавливаем зависимости (без --ignore-scripts, чтобы nodejieba скомпилировалась)
RUN bun install

# Копируем остальной код
COPY . .

# Собираем проект (если используете билд)
RUN bun run build

# Проверяем, что бинарник jieba существует (для отладки)
RUN find node_modules/nodejieba -name "*.node"

EXPOSE 4445

# Запускаем
CMD ["bun", "dist/index.js"]
