# syntax=docker/dockerfile:1
# =================================================================
# Этап 1: "builder" - Установка зависимостей и сборка админки
# =================================================================
FROM oven/bun:1.3-slim AS builder

WORKDIR /usr/src/app

COPY package.json bun.lock ./

COPY apps/admin/package.json ./apps/admin/

RUN bun install --ignore-scripts

COPY . .

ARG APP_VERSION="dev"

ENV VITE_APP_VERSION=$APP_VERSION

RUN bun --cwd=apps/admin run build

# =================================================================
# Этап 2: "release" - Создание финального образа с Nginx
# =================================================================
FROM nginx:stable-alpine

RUN rm -rf /usr/share/nginx/html/*

COPY --from=builder /usr/src/app/apps/admin/dist /usr/share/nginx/html

COPY <<'EOF' /etc/nginx/conf.d/default.conf
server {
    listen 3335;
    server_name localhost;
    client_max_body_size 5G;

    root /usr/share/nginx/html;
    index index.html;

    # --- Сжатие GZIP ---
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml+rss application/javascript application/json image/svg+xml;

    # --- Статика Vite ---
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
        try_files $uri =404;
    }

    # --- SPA Роутинг ---
    location / {
        add_header Cache-Control "no-cache, must-revalidate";
        try_files $uri $uri/ /index.html;
    }
}
EOF

EXPOSE 3335

CMD ["nginx", "-g", "daemon off;"]

