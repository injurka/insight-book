# syntax=docker/dockerfile:1
# =================================================================
# Этап 1: "builder" - Установка зависимостей и сборка админки
# =================================================================
FROM oven/bun:1.3-slim AS builder

WORKDIR /usr/src/app

COPY package.json bun.lock ./

COPY apps/admin/package.json ./apps/admin/

RUN bun install --ignore-scripts

COPY . .

ARG APP_VERSION="dev"

ENV VITE_APP_VERSION=$APP_VERSION

RUN bun --cwd=apps/admin run build

# =================================================================
# Этап 2: "release" - Создание финального образа с Nginx
# =================================================================
FROM nginx:stable-alpine

RUN rm -rf /usr/share/nginx/html/*

COPY --from=builder /usr/src/app/apps/admin/dist /usr/share/nginx/html

COPY <<'EOF' /etc/nginx/conf.d/default.conf
server {
    listen 3335;
    server_name localhost;
    client_max_body_size 5G;

    root /usr/share/nginx/html;
    index index.html;

    # --- Сжатие GZIP ---
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml+rss application/javascript application/json image/svg+xml;

    # --- Статика Vite ---
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
        try_files $uri =404;
    }

    # --- Конфиги приложения ---
    location /configs/ {
        try_files $uri =404;
        add_header Cache-Control "no-cache, must-revalidate";
        access_log off;
    }

    # --- SPA Роутинг ---
    location / {
        add_header Cache-Control "no-cache, must-revalidate";
        try_files $uri $uri/ /index.html;
    }
}
EOF

COPY <<'EOF' /entrypoint.sh
#!/bin/sh
# Генерирует рантайм-конфиг админки из переменных окружения при старте контейнера
set -e

mkdir -p /usr/share/nginx/html/configs
cat > /usr/share/nginx/html/configs/app-config.js <<CONFIG
// Сгенерировано entrypoint-ом контейнера при запуске
window.__APP_CONFIG__ = {
  API_URL: "${VITE_API_URL:-}",
}
CONFIG

exec nginx -g 'daemon off;'
EOF

RUN chmod +x /entrypoint.sh

EXPOSE 3335

CMD ["/entrypoint.sh"]

