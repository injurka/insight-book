{
  "name": "@injurka/insight-book-plugin-lotus-riddle",
  "version": "1.0.0",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5180 --strictPort",
    "build": "vite build && cp manifest.json dist/manifest.json",
    "pack": "bun run --filter @injurka/insight-book-pack-plugin pack $PWD",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "test": "bun test src"
  },
  "dependencies": {
    "@injurka/insight-book-plugin-api": "workspace:*",
    "vue": "3.5.42",
    "vue-router": "^5.3.1",
    "@iconify/vue": "^5.0.1"
  },
  "devDependencies": {
    "@injurka/insight-book-eslint-config": "workspace:*",
    "@module-federation/vite": "^1.21.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.9.1",
    "typescript": "7.0.2",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.11"
  }
}
