    "category": "grammar",
    "tags": [
      "questions",
      "location"
    ],
    "description": "Означает 'Где / Куда'. Является вопросительным местоимением.",
    "examples": [
      {
        "sentence": "你去哪儿？",
        "pinyin": "Nǐ qù nǎr?",
        "translation": "Куда ты идешь?"
