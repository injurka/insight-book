      {
        "sentence": "我想喝茶。",
        "pinyin": "Wǒ xiǎng hē chá.",
        "translation": "Я хочу выпить чаю."
      },
      {
        "sentence": "我想去中国。",
        "pinyin": "Wǒ xiǎng qù Zhōngguó.",
        "translation": "Я хочу (планирую) поехать в Китай."
      }
    ]
  },
  {
