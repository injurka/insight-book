    "tags": [
      "verbs",
      "location"
    ],
    "description": "В качестве глагола 在 означает 'находиться в'.",
    "examples": [
      {
        "sentence": "我在家。",
        "pinyin": "Wǒ zài jiā.",
        "translation": "Я (нахожусь) дома."
      },
      {
        "sentence": "他在中国。",
        "pinyin": "Tā zài Zhōngguó.",
        "translation": "Он в Китае."
      }
    ]
  },
  {
