  {
    "id": "hsk1_gram_02",
    "title": "Вопросы с частицей 吗 (ma)",
    "pattern": "Утверждение + 吗？",
    "hskLevel": "hsk1",
    "category": "grammar",
    "tags": [
      "sentence_structure",
      "particles",
      "questions"
    ],
    "description": "Частица 吗 ставится в конце повествовательного предложения, чтобы превратить его в общий вопрос (Да/Нет).",
    "examples": [
      {
        "sentence": "你是学生吗？",
        "pinyin": "Nǐ shì xuéshēng ma?",
        "translation": "Ты студент?"
      }
    ]
  },
  {
    "id": "hsk1_gram_03",
    "title": "Отрицание с 不 (bù)",
    "pattern": "Субъект + 不 + Глагол/Прилагательное",
    "hskLevel": "hsk1",
    "category": "grammar",
    "tags": [
      "negation"
    ],
    "description": "Отрицательная частица 不 используется для отрицания в настоящем и будущем времени, а также с прилагательными. Перед 4-м тоном 不 читается 2-м тоном (bú).",
    "examples": [
      {
        "sentence": "我不去医院。",
        "pinyin": "Wǒ bú qù yīyuàn.",
        "translation": "Я не иду в больницу."
      }
    ]
  },
  {
    "id": "hsk1_gram_04",
    "title": "Отрицание с 没 (méi) для глагола 有 (yǒu)",
    "pattern": "Субъект + 没 + 有 + Объект",
    "hskLevel": "hsk1",
    "category": "grammar",
    "tags": [
      "negation",
      "special_verbs"
    ],
    "description": "Глагол 有 (иметь) НИКОГДА не отрицается частицей 不. Для него всегда используется 没 (или 没有).",
    "examples": [
      {
        "sentence": "我没有钱。",
        "pinyin": "Wǒ méiyǒu qián.",
        "translation": "У меня нет денег."
      }
    ]
  },
  {
    "id": "hsk1_mw_01",
    "title": "Универсальное счетное слово 个 (gè)",
    "pattern": "Число/Указатель + 个 + Существительное",
    "hskLevel": "hsk1",
    "category": "measure_words",
    "tags": [
      "measure_words",
      "quantifiers"
    ],
    "description": "个 — самое распространенное счетное слово. Используется с людьми и многими предметами. Если не знаете нужное счетное слово — используйте 个.",
    "examples": [
      {
        "sentence": "三个人",
        "pinyin": "sān ge rén",
        "translation": "Три человека"
      },
      {
        "sentence": "一个苹果",
        "pinyin": "yí ge píngguǒ",
        "translation": "Одно яблоко"
      }
    ]
  },
  {
    "id": "hsk1_gram_05",
    "title": "Глагол 'быть' - 是 (shì)",
    "pattern": "Сущ./Мест. (A) + 是 + Сущ. (B)",
    "hskLevel": "hsk1",
    "category": "grammar",
    "tags": [
      "verbs"
    ],
    "description": "Связывает два существительных или местоимения. Не используется с прилагательными для описания свойств (нельзя сказать 我是好).",
    "examples": [
      {
        "sentence": "我是医生。",
        "pinyin": "Wǒ shì yīshēng.",
        "translation": "Я врач."
      }
    ]
  },
  {
    "id": "hsk1_gram_06",
    "title": "Прилагательные как сказуемое + 很 (hěn)",
    "pattern": "Субъект + 很 + Прилагательное",
    "hskLevel": "hsk1",
    "category": "grammar",
    "tags": [
      "adjectives",
      "adverbs"
    ],
    "description": "В утвердительных предложениях перед прилагательным-сказуемым обычно ставится 很 (очень), чтобы сбалансировать предложение, даже если мы не хотим сильно акцентировать 'очень'.",
    "examples": [
      {
        "sentence": "汉语很难。",
        "pinyin": "Hànyǔ hěn nán.",
        "translation": "Китайский язык сложный."
      }
    ]
  },
  {
    "id": "hsk1_gram_07",
    "title": "Указательные местоимения 这 (zhè) и 那 (nà)",
    "pattern": "这/那 + Счетное слово + Существительное",
