    "category": "grammar",
    "tags": [
      "pronouns",
      "demonstratives"
    ],
    "description": "这 означает 'этот' (близко), 那 означает 'тот' (далеко). Требуют после себя счетное слово перед существительным.",
    "examples": [
      {
        "sentence": "这个人是谁？",
        "pinyin": "Zhè ge rén shì shéi?",
        "translation": "Кто этот человек?"
      }
    ]
  },
  {
    "id": "hsk1_gram_08",
    "title": "Вопросительное слово 谁 (shéi / shuí)",
    "pattern": "谁 + 是 + ... / ... + 是 + 谁",
    "hskLevel": "hsk1",
    "category": "grammar",
    "tags": [
      "questions",
      "pronouns"
    ],
    "description": "Означает 'Кто'. В китайском вопросительное слово ставится на то же место в предложении, где будет ответ.",
    "examples": [
      {
        "sentence": "谁是你的老师？",
        "pinyin": "Shéi shì nǐ de lǎoshī?",
        "translation": "Кто твой учитель?"
      },
      {
        "sentence": "他是谁？",
        "pinyin": "Tā shì shéi?",
        "translation": "Кто он?"
      }
    ]
  },
  {
    "id": "hsk1_gram_09",
    "title": "Вопросительное слово 什么 (shénme)",
    "pattern": "Глагол + 什么 (+ Существительное)?",
    "hskLevel": "hsk1",
    "category": "grammar",
    "tags": [
      "questions",
      "pronouns"
    ],
    "description": "Означает 'Что' или 'Какой'.",
    "examples": [
      {
        "sentence": "这是什么？",
        "pinyin": "Zhè shì shénme?",
        "translation": "Что это?"
      },
      {
        "sentence": "你看什么书？",
        "pinyin": "Nǐ kàn shénme shū?",
        "translation": "Какую книгу ты читаешь?"
      }
    ]
  },
  {
    "id": "hsk1_gram_10",
    "title": "Вопросы о количестве с 几 (jǐ)",
    "pattern": "几 + Счетное слово + Существительное",
    "hskLevel": "hsk1",
    "category": "grammar",
    "tags": [
      "questions",
      "quantifiers"
    ],
    "description": "Используется для вопроса 'Сколько?', когда ожидаемый ответ меньше 10. Обязательно требует счетное слово.",
    "examples": [
      {
        "sentence": "你有几个苹果？",
        "pinyin": "Nǐ yǒu jǐ ge píngguǒ?",
        "translation": "Сколько у тебя яблок?"
      }
    ]
  },
  {
    "id": "hsk1_gram_11",
    "title": "Вопросы о количестве с 多少 (duōshao)",
    "pattern": "多少 + (Счетное слово) + Существительное",
    "hskLevel": "hsk1",
    "category": "grammar",
    "tags": [
      "questions",
      "quantifiers"
    ],
    "description": "Используется для вопроса 'Сколько?', когда ожидаемый ответ больше 10. Счетное слово можно опустить.",
    "examples": [
      {
        "sentence": "你们学校有多少学生？",
        "pinyin": "Nǐmen xuéxiào yǒu duōshao xuéshēng?",
        "translation": "Сколько студентов в вашей школе?"
      }
    ]
  },
  {
    "id": "hsk1_lex_01",
    "title": "Выражение даты: Месяцы и числа",
    "pattern": "...月 + ...号/日",
    "hskLevel": "hsk1",
    "category": "lexical",
    "tags": [
      "time_words",
      "numbers"
    ],
    "description": "Сначала называется месяц (число + 月), затем день (число + 号 (устно) или 日 (письменно)). От большего к меньшему.",
    "examples": [
      {
        "sentence": "八月十五号",
        "pinyin": "Bā yuè shíwǔ hào",
        "translation": "15 августа"
      }
    ]
  },
  {
    "id": "hsk1_gram_12",
    "title": "Частица принадлежности 的 (de)",
    "pattern": "Владелец + 的 + Предмет",
